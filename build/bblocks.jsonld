  "metaRegistry": "https://w3id.org/ogc/bblocks/meta-register.json",
  "name": "Building Blocks - OGC API Processes - Part 1 versions 1.0 and 2.0 draft",
  "abstract": "Part 1 version 1.0 (OGC 18-062r2) and the GeoLabs version 2.0 draft fork\n(OGC 18-062r3), hosted as independent part1.v1 and part1.v2 definitions.\nNamespace isolation is not a claim of full draft conformance.\n",
  "description": "Adds a flexible, JSON schema version agnostic documentation to the OGC API Processes standard, supporting further profiling by combining with other Building Blocks.\n",
  "sparqlEndpoint": "https://defs-dev.opengis.net/fuseki/query",
  "modified": "2026-11-10T14:39:31.793163",
